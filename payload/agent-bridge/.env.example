# 安装器会写好 .env；这里列一下常用的项，想手动改可以照着抄。
BOT_NAME=小鱼
WAKE_WORDS=小鱼
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=
ALLOWED_QQ=
ALLOWED_GROUPS=
DEEPSEEK_API_KEY=
DSH_HOME=
AGENT_CWD=
DSH_PERMISSION_MODE=workspace-write
PROACTIVE=true
PROACTIVE_QQ=
AUTONOMY=true
FACTS=true
MIMIC=true
PHONE_MONITOR=false
PHONE_PIN=
VOICE=false
DASHSCOPE_API_KEY=
VOICE_ID=
SING=false
SEEDVC_RUNTIME=
SEEDVC_PY=
# 心情头像（默认关）：她心情变了 QQ 头像跟着换。图放 agent-bridge\data\avatars\，按心情起名：平常、开心、生气、委屈、困、睡觉（还可以有 得意、烦、无聊、懒），至少要有 平常
MOOD_AVATAR=false
# 下面四个也默认关，想要就改成 true（详见 使用说明.md）
# 电脑室友：看得见这台电脑在放什么歌、开着什么游戏、开了多久，只跟 PROACTIVE_QQ 第一个人提
PC_BUDDY=false
# 做梦：早上醒来有时记得昨晚的梦，第一次聊天时顺口说
DREAM=false
# 现场照：问她在干嘛时回一张“现在的她”，要自己在 agent-bridge\data\scene\bg、pose 里放图
PHOTO=false
# 每周一封信：周日晚上写一封，信纸用百炼通义万相画（要 DASHSCOPE_API_KEY，没有就用素纸）
LETTER=false
# 下面这些也默认关（详见 使用说明.md）
# 自定义在线状态：名字旁边写她自己的一句话（在干嘛 / 陪你听什么 / 心情）
DIY_STATUS=false
# 作息被你带偏：你老熬夜，她也跟着晚睡（最多晚 2 小时）
SLEEP_DRIFT=false
# 电脑上的她（要电脑室友）：回来时从电脑喇叭打个招呼（要开语音）、离开久了在桌面留张便条、桌面上放一个“她的抽屉”
SPEAKER=false
NOTES=false
DRAWER=false
# 用电脑上的 QQ 音乐放歌（你在电脑前就直接放，不在就发链接）
PLAY_MUSIC=false
# 旅行明信片：隔几周的周末她出去玩一趟，寄一张明信片（正面用百炼画，要 DASHSCOPE_API_KEY）
POSTCARD=false
# QQ 空间说说：偶尔把自己最近干的事发一条（好友可见，不写聊天内容）
QZONE=false
# 她自己的小屋（ChronoLife）：没人找她时也在过日子——养植物、整理笔记、写点东西，聊天时记得；见 agent-bridge\packages\life\chronolife\README.md
CHRONOLIFE=false
# 小屋里有了具体的事偶尔主动跟你说一句（一周最多 3 条，夜里不发）
CHRONOLIFE_PROACTIVE=false
# 时区，不填就用电脑的
CHRONOLIFE_TIMEZONE=
# 每个功能的全部设置见 agent-bridge\packages\<插件>\README.md；只想带几个插件：COMPANION_ONLY=speech,memory（不写就是全部）
